# Copy this file to .env and fill in your own values. Never commit .env.

# Your store's *.myshopify.com domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# From your app in the Shopify Dev Dashboard (dev.shopify.com/dashboard):
# open your app > Settings > Client credentials.
# As of Jan 1, 2026, Shopify apps authenticate via OAuth client credentials
# instead of a static Admin API token, so both values below are required.
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# Optional: override the Admin API version this app targets
SHOPIFY_API_VERSION=2026-07

# Optional: port the server listens on
PORT=3000


