# Copy this file to .env and fill in your own values. Never commit .env.

# Your store's *.myshopify.com domain (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from a custom app with the write_customers scope
# Shopify Admin > Settings > Apps and sales channels > Develop apps
SHOPIFY_ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the Admin API version this app targets
SHOPIFY_API_VERSION=2026-07

# Optional: port the server listens on
PORT=3000
